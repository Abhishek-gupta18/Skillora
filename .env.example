PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Directory outside public/ to store uploaded resumes (never served statically)
# Defaults to ./resume-storage relative to project root if left blank
RESUME_STORAGE_DIR=./resume-storage

# Judge0 CE API via RapidAPI
RAPIDAPI_KEY=
# Get from https://rapidapi.com after subscribing to the Judge0 CE API (Basic/free plan)
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
