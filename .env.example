PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT expiry (e.g. '7d', '1h', '30m') — default '7d'
JWT_EXPIRES_IN=7d

# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# DATABASE_SSL=false is ONLY for a local Postgres WITHOUT TLS.
# For Supabase leave UNSET so TLS with the CA certificate is used (DATABASE_SSL_CA_PATH optional).
# DATABASE_SSL=false

# Path to CA certificate for LOCAL Postgres SSL (only used if DATABASE_SSL is not 'false')
# DATABASE_SSL_CA_PATH=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Directory outside public/ to store uploaded resumes (never served statically)
# Defaults to ./resume-storage relative to project root if left blank
RESUME_STORAGE_DIR=./resume-storage

# Trust proxy for rate limiter IP detection behind reverse proxy (Render, Railway, Nginx)
# 'false' -> disable; '1' -> one proxy (default); '2' -> two proxies, etc.
TRUST_PROXY=1

# Admin bootstrap credentials (ONLY used by prisma/seedAdmin.js; remove from .env after admin is created)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Judge0 CE API via RapidAPI
RAPIDAPI_KEY=
# Get from https://rapidapi.com after subscribing to the Judge0 CE API (Basic/free plan)
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com