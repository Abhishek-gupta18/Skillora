const { test, describe } = require('node:test');
const assert = require('node:assert');
const { prepareBulkQuestions } = require('../utils/questionBulk');

describe('prepareBulkQuestions', () => {
  const seed = 'test-seed-123';

  test('valid 20 questions with correctOptionIndex 0 - text preserved', () => {
    const questions = Array.from({ length: 20 }, (_, i) => ({
      promptText: `Question ${i}`,
      options: ['A', 'B', 'C', 'D'],
      correctOptionIndex: 0,
    });

    const result = prepareBulkQuestions(questions, seed);

    assert.strictEqual(result.questions.length, 20);
    assert.strictEqual(result.skipped.length, 0);
    // Check that correct option text is preserved (all should be 'A')
    for (const q of result.questions) {
      assert.strictEqual(q.options[q.correctOptionIndex], 'A');
    }
  });

  test('empty option rejected', () => {
    const questions = [
      {
        promptText: 'Valid question',
        options: ['A', '', 'C', 'D'],
        correctOptionIndex: 0,
      },
    ];

    const result = prepareBulkQuestions(questions, seed);
    assert.strictEqual(result.questions.length, 0);
    assert.strictEqual(result.skipped.length, 1);
    assert.ok(result.skipped[0].reason.includes('non-empty string'));
  });

  test('in-batch duplicate skipped', () => {
    const questions = [
      { promptText: 'Same question', options: ['A', 'B', 'C', 'D'], correctOptionIndex: 0 },
      { promptText: 'Same question', options: ['W', 'X', 'Y', 'Z'], correctOptionIndex: 1 },
    ];

    const result = prepareBulkQuestions(questions, seed);
    assert.strictEqual(result.questions.length, 1);
    assert.strictEqual(result.skipped.length, 1);
    assert.ok(result.skipped[0].reason.includes('duplicate promptText in batch'));
  });

  test('distribution counts correct', () => {
    const questions = Array.from({ length: 20 }, (_, i) => ({
      promptText: `Q${i}`,
      options: ['A', 'B', 'C', 'D'],
      correctOptionIndex: i % 4,
    });

    const result = prepareBulkQuestions(questions, 'dist-seed');

    // With 20 questions and 4 options, each index should appear 5 times
    assert.deepStrictEqual(result.distribution, { '0': 5, '1': 5, '2': 5, '3': 5 });
  });

  test('correct option TEXT unchanged after balancing', () => {
    const questions = [
      { promptText: 'Q1', options: ['Correct', 'Wrong1', 'Wrong2', 'Wrong3'], correctOptionIndex: 0 },
      { promptText: 'Q2', options: ['Wrong1', 'Correct', 'Wrong2', 'Wrong3'], correctOptionIndex: 1 },
    ];

    const result = prepareBulkQuestions(questions, 'balance-seed');

    // After balancing, correct option text must be 'Correct' for both
    assert.strictEqual(result.questions[0].options[result.questions[0].correctOptionIndex], 'Correct');
    assert.strictEqual(result.questions[1].options[result.questions[1].correctOptionIndex], 'Correct');
  });

  test('throws on empty options array', () => {
    const questions = [
      { promptText: 'Q1', options: [], correctOptionIndex: 0 },
    ];

    assert.throws(() => prepareBulkQuestions(questions, 'seed'), /options must be 2-6 strings/);
  });

  test('throws on correctOptionIndex out of bounds', () => {
    const questions = [
      { promptText: 'Q1', options: ['A', 'B'], correctOptionIndex: 5 },
    ];

    assert.throws(() => prepareBulkQuestions(questions, 'seed'), /correctOptionIndex out of bounds/);
  });

  test('rejects empty string option', () => {
    const questions = [
      { promptText: 'Q1', options: ['A', '', 'C'], correctOptionIndex: 0 },
    ];

    const result = prepareBulkQuestions(questions, seed);
    assert.strictEqual(result.questions.length, 0);
    assert.strictEqual(result.skipped.length, 1);
  });

  test('null option rejected', () => {
    const questions = [
      { promptText: 'Q1', options: ['A', null, 'C'], correctOptionIndex: 0 },
    ];

    const result = prepareBulkQuestions(questions, seed);
    assert.strictEqual(result.questions.length, 0);
    assert.strictEqual(result.skipped.length, 1);
  });

  test('undefined option rejected', () => {
    const questions = [
      { promptText: 'Q1', options: ['A', undefined, 'C'], correctOptionIndex: 0 },
    ];

    const result = prepareBulkQuestions(questions, seed);
    assert.strictEqual(result.questions.length, 0);
    assert.strictEqual(result.skipped.length, 1);
  });
});