generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(CANDIDATE)
  isEmailVerified Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile?

  @@index([status])
}

model Profile {
  id                   String                @id @default(cuid())
  userId               String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  address              Address?
  applications         Application[]
  assessmentSessions   AssessmentSession[]
  availability         AvailabilitySetting?
  basicInfo            BasicInfo?
  careerSummary        CareerSummary?
  certifications       Certification[]
  educationEntries     EducationEntry[]
  experienceEntries    ExperienceEntry[]
  interviewExperiences InterviewExperience[]
  languages            LanguageKnown[]
  preferredLocations   PreferredLocation[]
  preferredRoles       PreferredRole[]
  privacyConsent       PrivacyConsent?
  user                 User                  @relation(fields: [userId], references: [id])
  photoHeadline        ProfilePhotoHeadline?
  projects             Project[]
  references           Reference[]
  resume               Resume?
  salaryExpectation    SalaryExpectation?
  skillClaims          SkillClaim[]
  socialLinks          SocialLink[]

  @@index([userId])
}

model BasicInfo {
  id        String   @id @default(cuid())
  profileId String   @unique
  name      String
  dob       DateTime
  gender    String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfilePhotoHeadline {
  id        String   @id @default(cuid())
  profileId String   @unique
  photoUrl  String?
  headline  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  profileId String   @unique
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model EducationEntry {
  id           String   @id @default(cuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String
  startYear    Int
  endYear      Int?
  grade        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ExperienceEntry {
  id          String    @id @default(cuid())
  profileId   String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SkillClaim {
  id             String   @id @default(cuid())
  profileId      String
  skillId        String
  selfRatedLevel Int
  verifiedScore  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id])

  @@unique([profileId, skillId])
  @@index([skillId])
  @@index([profileId])
}

model Certification {
  id            String   @id @default(cuid())
  profileId     String
  name          String
  issuer        String
  issueDate     DateTime
  credentialUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String
  techStack   String[]
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CareerSummary {
  id        String   @id @default(cuid())
  profileId String   @unique
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PreferredRole {
  id        String   @id @default(cuid())
  profileId String
  roleName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleName])
  @@index([profileId])
}

model PreferredLocation {
  id           String   @id @default(cuid())
  profileId    String
  locationName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locationName])
  @@index([profileId])
}

model SalaryExpectation {
  id        String   @id @default(cuid())
  profileId String   @unique
  minAmount Int
  maxAmount Int
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AvailabilitySetting {
  id           String       @id @default(cuid())
  profileId    String       @unique
  availability Availability
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LanguageKnown {
  id          String              @id @default(cuid())
  profileId   String
  language    String
  proficiency LanguageProficiency
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  profile     Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
  @@index([profileId])
}

model SocialLink {
  id        String         @id @default(cuid())
  profileId String
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
  @@index([profileId])
}

model Resume {
  id         String   @id @default(cuid())
  profileId  String   @unique
  fileUrl    String
  fileHash   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Reference {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  relation    String
  contactInfo String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model PrivacyConsent {
  id                 String            @id @default(cuid())
  profileId          String            @unique
  profileVisibility  ProfileVisibility @default(PRIVATE)
  dataSharingConsent Boolean           @default(false)
  consentTimestamp   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  profile            Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id                 String              @id @default(cuid())
  name               String              @unique
  category           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentSessions AssessmentSession[]
  codingQuestions    CodingQuestion[]
  jobRequirements    JobRequiredSkill[]
  questions          Question[]
  skillClaims        SkillClaim[]

  @@index([category])
}

model Question {
  id                 String             @id @default(cuid())
  skillId            String
  promptText         String
  options            String[]
  correctOptionIndex Int
  difficulty         QuestionDifficulty
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  answers            AssessmentAnswer[]
  skill              Skill              @relation(fields: [skillId], references: [id])

  @@index([skillId])
  @@index([difficulty])
}

model CodingQuestion {
  id          String             @id @default(cuid())
  skillId     String
  promptText  String
  starterCode String?
  difficulty  QuestionDifficulty
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  skill       Skill              @relation(fields: [skillId], references: [id])
  submissions CodingSubmission[]
  testCases   TestCase[]

  @@index([skillId])
  @@index([difficulty])
}

model TestCase {
  id               String         @id @default(cuid())
  codingQuestionId String
  input            String
  expectedOutput   String
  isHidden         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  codingQuestion   CodingQuestion @relation(fields: [codingQuestionId], references: [id], onDelete: Cascade)

  @@index([codingQuestionId])
}

model AssessmentSession {
  id                   String             @id @default(cuid())
  profileId            String
  skillId              String
  targetLevel          Int
  passThresholdPercent Int
  status               SessionStatus      @default(IN_PROGRESS)
  startedAt            DateTime           @default(now())
  expiresAt            DateTime
  completedAt          DateTime?
  score                Float?
  passed               Boolean?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  answers              AssessmentAnswer[]
  profile              Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill                Skill              @relation(fields: [skillId], references: [id])
  submissions          CodingSubmission[]

  @@index([profileId])
  @@index([skillId])
  @@index([status])
}

model AssessmentAnswer {
  id                  String            @id @default(cuid())
  sessionId           String
  questionId          String
  selectedOptionIndex Int
  isCorrect           Boolean
  createdAt           DateTime          @default(now())
  question            Question          @relation(fields: [questionId], references: [id])
  session             AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model CodingSubmission {
  id               String            @id @default(cuid())
  sessionId        String
  codingQuestionId String
  submittedCode    String
  languageId       Int
  // One Judge0 submission token per TestCase, in the same order as the
  // test cases were submitted (visible cases first, then hidden) — used
  // to poll batch results.
  judge0Tokens     String[]
  status           SubmissionStatus  @default(PENDING)
  testCasesPassed  Int               @default(0)
  testCasesTotal   Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  codingQuestion   CodingQuestion    @relation(fields: [codingQuestionId], references: [id])
  session          AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, codingQuestionId])
  @@index([sessionId])
  @@index([codingQuestionId])
}

model Company {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  website              String?
  industry             String?
  logoUrl              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  interviewExperiences InterviewExperience[]
  jobPostings          JobPosting[]          @relation("CompanyJobPosting")
}

model JobPosting {
  id                   String                @id @default(cuid())
  companyId            String
  title                String
  description          String
  employmentType       EmploymentType
  experienceLevel      ExperienceLevel
  location             String
  isRemote             Boolean               @default(false)
  salaryMin            Int?
  salaryMax            Int?
  currency             String                @default("INR")
  status               JobStatus             @default(DRAFT)
  postedAt             DateTime?
  closesAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  applications         Application[]
  interviewExperiences InterviewExperience[]
  company              Company               @relation("CompanyJobPosting", fields: [companyId], references: [id])
  jobRequiredSkills    JobRequiredSkill[]

  @@index([companyId])
  @@index([status])
}

model JobRequiredSkill {
  id           String     @id @default(cuid())
  jobPostingId String
  skillId      String
  minimumLevel Int
  isRequired   Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])
  skill        Skill      @relation(fields: [skillId], references: [id])

  @@unique([jobPostingId, skillId])
  @@index([jobPostingId])
  @@index([skillId])
}

model Application {
  id              String            @id @default(cuid())
  profileId       String
  jobPostingId    String
  status          ApplicationStatus @default(APPLIED)
  coverNote       String?
  appliedAt       DateTime          @default(now())
  statusUpdatedAt DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id])
  profile         Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobPostingId])
  @@index([profileId])
  @@index([jobPostingId])
  @@index([status])
}

model InterviewExperience {
  id              String           @id @default(cuid())
  authorProfileId String
  companyName     String
  companyId       String?
  roleTitle       String
  jobPostingId    String?
  outcome         InterviewOutcome
  interviewDate   DateTime?
  isAnonymous     Boolean          @default(false)
  narrative       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authorProfile   Profile          @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id])
  jobPosting      JobPosting?      @relation(fields: [jobPostingId], references: [id])
  rounds          InterviewRound[]

  @@index([authorProfileId])
  @@index([companyId])
  @@index([jobPostingId])
  @@index([outcome])
}

model InterviewRound {
  id                    String              @id @default(cuid())
  interviewExperienceId String
  roundOrder            Int
  roundType             InterviewRoundType
  questionsAsked        String[]
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  interviewExperience   InterviewExperience @relation(fields: [interviewExperienceId], references: [id], onDelete: Cascade)

  @@index([interviewExperienceId])
}

enum UserRole {
  CANDIDATE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Availability {
  IMMEDIATE
  DAYS_15
  DAYS_30
  DAYS_60_PLUS
}

enum LanguageProficiency {
  BEGINNER
  CONVERSATIONAL
  FLUENT
  NATIVE
}

enum SocialPlatform {
  LINKEDIN
  GITHUB
  PORTFOLIO
  OTHER
}

enum ProfileVisibility {
  PUBLIC
  RECRUITERS_ONLY
  PRIVATE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WITHDRAWN
  HIRED
}

enum InterviewOutcome {
  SELECTED
  REJECTED
  PENDING
  WITHDREW
}

enum InterviewRoundType {
  ONLINE_ASSESSMENT
  TECHNICAL
  HR
  MANAGERIAL
  SYSTEM_DESIGN
  GROUP_DISCUSSION
  OTHER
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}
